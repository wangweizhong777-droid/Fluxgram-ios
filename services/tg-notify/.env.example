# Keep the real values only in the NAS-side .env file.
BARK_DEVICE_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BARK_ICON_URL=https://your-gateway.example.com/notify-avatars/fluxgram-icon.png
# Optional, LAN-only status endpoint. Set this to the same private access
# token used by Fluxgram; never commit the actual value.
NOTIFY_STATUS_TOKEN=
NOTIFY_STATUS_PORT=30178
# Optional; defaults to /data/seen-messages.json. Keep it on the mounted data volume.
NOTIFY_SEEN_MESSAGES_PATH=/data/seen-messages.json
# Optional; failed Bark notifications are retried from this durable ID queue.
NOTIFY_PENDING_NOTIFICATIONS_PATH=/data/pending-notifications.json
# Optional; persists the Fluxgram notification switch on the NAS data volume.
NOTIFY_SETTINGS_PATH=/data/notification-settings.json
