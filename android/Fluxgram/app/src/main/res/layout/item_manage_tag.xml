<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tagName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/accent_neon"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tagUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/editTag"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="编辑标签"
        android:padding="10dp"
        android:src="@drawable/ic_edit"
        android:tint="@color/accent_neon" />

    <ImageButton
        android:id="@+id/deleteTag"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="&#x5220;&#x9664;&#x6807;&#x7B7E;"
        android:padding="10dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/accent_pink" />
</LinearLayout>
