<resources>
    <style name="Theme.NasTok" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="colorPrimary">@color/accent_neon</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorSurfaceVariant">@color/bg_card</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/accent_pink</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <!-- Splash screen theme: black background with the app icon centered. Applied only
         to HomeActivity in the manifest; installSplashScreen() transitions to Theme.NasTok. -->
    <style name="Theme.NasTok.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NasTok</item>
    </style>

    <style name="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#143390EC</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NasTok.NavIndicator</item>
    </style>

    <style name="ShapeAppearance.NasTok.NavIndicator" parent="ShapeAppearance.Material3.Corner.Full" />
</resources>
